# Government of India Open Government Data (data.gov.in) — AGMARKNET daily prices
# Register at https://data.gov.in and create an API key. Do not invent keys.
DATA_GOV_IN_API_BASE=https://api.data.gov.in/resource
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001c9ca7609485a4e39445a17862b667b20
# Official AGMARKNET "Current Daily Price of Various Commodities" resource
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Optional second resource (variety-wise daily prices) if the primary fails
DATA_GOV_IN_FALLBACK_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# Limit how many mandi records to pull per scheduled run (pagination still used)
MANDI_SYNC_MAX_RECORDS=300
MANDI_SYNC_STATES=Maharashtra,Karnataka,Madhya Pradesh,Gujarat,Rajasthan

# Weather — Open-Meteo (documented public API, no key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# Optional OpenWeatherMap (leave blank to use Open-Meteo)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Road distance — public OSRM. If unreachable, haversine estimate is used and labelled.
